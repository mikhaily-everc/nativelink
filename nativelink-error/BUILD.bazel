load(
    "@rules_rust//rust:defs.bzl",
    "rust_doc",
    "rust_doc_test",
    "rust_library",
    "rust_test",
    "rust_test_suite",
)

# Default-public so cross-workspace mutation_test targets (in the outer ai-utils
# workspace at //tools/cargo-mutants/nativelink/...) can reference the
# rust_test_suite-generated rust_test sub-targets — those inherit the package
# default visibility, which would otherwise be private.
package(default_visibility = ["//visibility:public"])

rust_library(
    name = "nativelink-error",
    srcs = [
        "src/lib.rs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//nativelink-metric",
        "//nativelink-proto",
        "@crates//:base64",
        "@crates//:mongodb",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:redis",
        "@crates//:reqwest",
        "@crates//:rustls-pki-types",
        "@crates//:serde",
        "@crates//:serde_json5",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:url",
        "@crates//:uuid",
        "@crates//:walkdir",
        "@crates//:zip",
    ],
)

rust_test_suite(
    name = "integration",
    timeout = "short",
    srcs = [
        "tests/error_tests.rs",
        "tests/lib_tests.rs",
    ],
    deps = [
        "//nativelink-error",
        "//nativelink-metric",
        "//nativelink-proto",
        "@crates//:prost",
        "@crates//:redis",
        "@crates//:tokio",
        "@crates//:tonic",
        "@crates//:tracing",
        "@crates//:walkdir",
    ],
)

rust_test(
    name = "unit_test",
    timeout = "short",
    crate = ":nativelink-error",
    deps = [
        "//nativelink-metric",
        "//nativelink-proto",
        "@crates//:async-lock",
        "@crates//:hex",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:redis",
        "@crates//:serde",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
)

rust_doc(
    name = "docs",
    crate = ":nativelink-error",
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    timeout = "short",
    crate = ":nativelink-error",
)
